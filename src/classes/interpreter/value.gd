@abstract
class_name Value
extends RefCounted
## Abstract class for values generated by the interpreter.
##
## All values generated by the interpreter inherit from this class.

## Enumeration of possible value types.
enum Type {
	INT,
	BOOL,
	TUPLE,
	LIST,
	CLOSURE,
	THUNK,
	ERROR,
}

## Enumeration of possible value subtypes.
## @experimental: No current plan of use, but may be useful for future features.
enum Subtype {
	RAW,
	WATER,
	EARTH,
	FIRE,
	AIR,
}

## Type of the value
var type: Type


## Forces the evaluation of a [Value.Thunk].[br]
## [Value.Thunk] are generated by deferring computation
## of interpreted expressions.
func force() -> Value:
	return self


## True when the value carries a structured runtime error. Operators
## that force their operands check this and propagate the error
## upward instead of crashing on a missing field. The runner
## inspects the final result and surfaces the message in the output
## panel.
func is_error() -> bool:
	return type == Type.ERROR


## Returns the human-readable runtime-error message for an Error
## value; empty for any other value type.
func error_message() -> String:
	return ""


## Convenience factory for an error Value. Used by `Expr.Var` when
## env lookup fails (free identifier) and by any operator that
## detects an unrecoverable runtime condition without a Godot-side
## exception path.
static func error(message: String) -> Value:
	return ErrorValue.new(message)


## Human-readable name of this value's type, for runtime-error
## messages ("Addition expected (Int, Int), but received (Int, Bool)").
func type_to_string() -> String:
	match type:
		Type.INT:
			return "Int"
		Type.BOOL:
			return "Bool"
		Type.TUPLE:
			return "Tuple"
		Type.LIST:
			return "List"
		Type.CLOSURE:
			return "Function"
		Type.THUNK:
			return "Thunk"
		Type.ERROR:
			return "Error"
		_:
			return "Unknown"


## Unwraps the [GDScript] representation of the value.
@abstract func unwrap() -> Variant


## Integer value class
##
## Represents computed [int] values.
class Int extends Value:
	var value: int

	
	func _init(n: int) -> void:
		type = Type.INT
		value = n


	func _to_string() -> String:
		return "Value.Int(%d)" % value

	
	func unwrap() -> int:
		return value


## Boolean value class
##
## Represents computed [bool] values
class Bool extends Value:
	var value: bool


	func _init(b: bool) -> void:
		type = Type.BOOL
		value = b


	func _to_string() -> String:
		return "Value.Bool(%s)" % str(value)


	func unwrap() -> Variant:
		return value


## Tuple value class
##
## Represents a computed tuple.[br]
## It can contain [Thunks].[br]
## Tuples are heterogeneous and of fixed size.
class Tuple extends Value:
	var elements: Array[Value]


	func _init(elems: Array[Value]) -> void:
		type = Type.TUPLE
		elements = elems


	func _to_string() -> String:
		return "Value.Tuple(%s)" % str(elements)


	func unwrap() -> Variant:
		var result = []
		for element in elements:
			var forced = element.force()
			if forced == null or forced.is_error():
				var msg: String = "?" if forced == null else forced.error_message()
				result.append("<error: %s>" % msg)
				continue
			result.append(forced.unwrap())
		return result


	func get_element(index: int) -> Value:
		if index < 0 or index >= elements.size():
			push_error("Tuple index out of bounds.")
			return null
		return elements[index]


	func size() -> int:
		return elements.size()


## List value class
##
## Lists are lazily evaluated and of variable length.
class List extends Value:
	var head: Value:
		get:
			if _head == null:
				push_error("Attempted to access head of an empty list.")
				return null
			
			return _head.force()

	var tail: Value:
		get:
			if head == null:
				push_error("Attempted to access tail of an empty list.")
				return null
			
			var forced_tail = _tail.force()
			
			if forced_tail.type != Type.LIST:
				return null
			
			return forced_tail

	var tail_expr: Expr:
		get:
			if head == null:
				push_error("Attempted to access tail expression of an empty list.")
				return null
			
			if _tail.type == Type.THUNK:
				return _tail._expr
			else:
				return Expr.Constant.new(_tail)

	var is_empty: bool:
		get:
			return _head == null

	var _head: Value
	var _tail: Value


	static func from_array(values: Array[Value]) -> List:
		if values.size() == 0:
			return List.new(null, null)

		var result = List.new(null, null)
		for i in range(values.size() - 1, -1, -1):
			result = List.new(values[i], result)
		return result


	func _init(h: Value = null, t: Value = null) -> void:
		type = Type.LIST
		_head = h
		_tail = t


	func _to_string() -> String:
		if _tail.type == Type.THUNK:
			return "Value.List(%s, <deferred>)" % _head
		else:
			return "Value.List(%s, %s)" % [_head, _tail]

	
	func unwrap() -> Variant:
		if is_empty:
			return []
		
		var result = []
		var current = self
		
		# Limit for infinite lists (for display/debugging)
		var max_elements = 50
		var count = 0
		
		while not current.is_empty and count < max_elements:
			var head_val = current.head
			if head_val == null:
				break
			head_val = head_val.force()
			if head_val == null or head_val.is_error():
				var msg: String = "?" if head_val == null else head_val.error_message()
				result.append("<error: %s>" % msg)
				break

			result.append(head_val.unwrap())

			var tail_val = current.tail  # Forces tail structure
			if tail_val == null:
				# Forcing the tail failed (error or non-list) — stop
				# rather than crash on a null deref.
				result.append("<error: invalid list tail>")
				break
			current = tail_val
			count += 1
		
		if count >= max_elements:
			result.append("...")  # Indicate truncation
		
		return result

	
	## Prepends value to list
	func cons(value: Value) -> List:
		return Value.List.new(value, self)


## Function closure value class
##
## Represents a function closure, which consists of a function body,
## a list of parameters, and the environment in which it was defined.
class Closure extends Value:
	var body: Expr
	var params: Array[Pattern]
	var env: Env


	func _init(b: Expr, p: Array[Pattern], e: Env) -> void:
		type = Type.CLOSURE
		body = b
		params = p
		env = e


	func _to_string() -> String:
		return "Value.Closure(%s, %s, <env>)" % [body, str(params)]


	func unwrap() -> Variant:
		return "<function>"


	func apply(args: Array[Value]) -> Value:
		var bindings: Dictionary[String, Value] = {}
		var n_to_match = min(params.size(), args.size())

		for i in range(n_to_match):
			var match_result = params[i].match(args[i])

			if not match_result["matched"]:
				return Value.error("Pattern match failed in function application")

			bindings.merge(match_result["bindings"])

		var extended_env = env.define_in_new_frame_batch(bindings)

		if args.size() < params.size(): # Partial application case
			var remaining_params = params.slice(args.size())
			return Value.Closure.new(body, remaining_params, extended_env)

		elif args.size() > params.size(): # Over-application case
			var first_result = Value.Thunk.new(body, extended_env).force()

			if first_result == null:
				return Value.error("internal: function body produced no value")
			elif first_result.is_error():
				return first_result
			elif first_result.type == Type.CLOSURE:
				return first_result.apply(args.slice(params.size()))
			else:
				return Value.error(
						"Attempted to apply %d extra argument(s) to a non-function value (%s)"
						% [args.size() - params.size(), first_result.type_to_string()])
		
		else: # Exact application case
			return Value.Thunk.new(body, extended_env)


## Native closure value class
##
## Wraps a native static GDScript function as a closure value.
class NativeClosure extends Value:
	var _callback: Callable
	var _arity: int
	var _args: Array[Value]


	func _init(callback: Callable, arity: int, args: Array[Value] = []) -> void:
		type = Type.CLOSURE
		_callback = callback
		_arity = arity
		_args = args


	func _to_string() -> String:
		return "Value.NativeClosure(%s, arity=%d)" % [_callback, _arity]


	func unwrap() -> Variant:
		return _callback


	func apply(args: Array[Value]) -> Value:
		var total_args = _args + args

		if total_args.size() < _arity:
			return Value.NativeClosure.new(_callback, _arity, total_args)
		elif total_args.size() == _arity:
			return Value.Thunk.new(Expr.NativeCall.new(_callback, total_args), Env.new())
		else:
			return Value.error(
					"Too many arguments applied to native function (expected %d, got %d)"
					% [_arity, total_args.size()])


## Thunk value class
##
## Represents differed computations during interpretation.
##
## `force()` runs an iterative graph-reduction engine: instead of the
## native mutual recursion force → evaluate → evaluate_strictly →
## interpret → force (which overflowed the GDScript stack on deep
## non-tail recursion), both thunk chains and strict-operator operand
## evaluation are flattened onto one heap-allocated task stack.
class Thunk extends Value:
	const MAX_FORCE_DEPTH := 100_000

	# Step budget shared across nested force() entries. Lazy operators
	# (&&, ||, !, ++) and prelude natives re-enter force() from inside
	# their evaluate(), which the task stack cannot flatten; resetting
	# the counter only at the outermost entry keeps the total work per
	# top-level evaluation bounded. NOTE: these statics are process-wide,
	# so two threads evaluating at once could misattribute budget — the
	# checker enforces one background check at a time, and the worst
	# case is a spurious/late "exceeded steps" error, never a crash.
	static var _steps := 0
	static var _nesting := 0

	# Every thunk created while a force is in flight, so a budget abort
	# can poison them all (see _poison_created). Cleared when the
	# outermost force returns; on success the entries simply keep living
	# in whatever structure references them.
	static var _created: Array[Thunk] = []

	var evaluated := false ## If the thunk has been forced and cached the result.
	var _expr: Expr
	var _env: Env
	var _cache: Value = null


	# One frame of the reduction engine. `kind` selects the dispatch
	# arm; the remaining fields are arm-specific. A class beats a
	# Dictionary here: field access avoids string-keyed lookups at
	# 500k-iteration scale.
	class _EvalTask extends RefCounted:
		const THUNK := 0        # evaluate `thunk`'s expression
		const THUNK_STORE := 1  # cache last_result into `thunk`
		const OPERATOR := 2     # step through `operands`, then compute()
		const ARG_STORE := 3    # append last_result to `parent`.args
		var kind: int
		var thunk: Thunk
		var op: Operator
		var env: Env
		var operands: Array[Expr]
		var args: Array[Value] = []
		var index := 0
		var parent: _EvalTask

		func _init(p_kind: int) -> void:
			kind = p_kind


	func _init(expr: Expr, env: Env) -> void:
		type = Type.THUNK
		_expr = expr
		_env = env
		if _nesting > 0:
			_created.append(self)


	func _to_string() -> String:
		if not evaluated:
			return "Value.Thunk(%s, <env>)" % _expr
		else:
			return "Value.Thunk(<cached: %s>)" % _cache


	func force() -> Value:
		if evaluated:
			return _cache
		if _nesting == 0:
			_steps = 0
		_nesting += 1
		var result := _reduce()
		_nesting -= 1
		if _nesting == 0:
			_created.clear()
		return result


	# Propagate an error to every thunk still waiting on the stack —
	# they would all evaluate to it — then abandon the reduction.
	static func _unwind(stack: Array[_EvalTask], err: Value) -> Value:
		for task in stack:
			if task.kind == _EvalTask.THUNK_STORE:
				task.thunk._cache = err
				task.thunk.evaluated = true
		return err


	# Budget-abort cleanup: a runaway recursion leaves behind a deep
	# thunk → env → thunk linked chain that Godot would tear down with
	# native destructor recursion — past ~50k links that segfaults
	# regardless of how iterative the evaluation itself was. Poison
	# every thunk created during this force (they would all evaluate to
	# the error anyway) and cut their links so teardown stays shallow.
	static func _poison_created(err: Value) -> void:
		for t in _created:
			if not t.evaluated:
				t._cache = err
				t.evaluated = true
			t._expr = null
			t._env = null
		_created.clear()


	func _reduce() -> Value:
		var root := _EvalTask.new(_EvalTask.THUNK)
		root.thunk = self
		var stack: Array[_EvalTask] = [root]
		var last_result: Value = null

		while not stack.is_empty():
			_steps += 1
			if _steps > MAX_FORCE_DEPTH:
				var err := Value.error(
						"evaluation exceeded %d steps (infinite loop?)" % MAX_FORCE_DEPTH)
				# Cache on the root so a re-force reports instantly
				# instead of re-spinning the whole budget.
				_cache = err
				evaluated = true
				_unwind(stack, err)
				stack.clear()
				_poison_created(err)
				return err

			var task: _EvalTask = stack.pop_back()

			match task.kind:
				_EvalTask.THUNK:
					var thunk := task.thunk
					if thunk.evaluated:
						last_result = thunk._cache
						continue

					var expr := thunk._expr
					var res: Value

					if expr is Operator:
						var strict_ops: Array[Expr] = expr.get_strict_operands()
						if strict_ops.size() > 0:
							# Strict operator: evaluate its operands on
							# this stack instead of recursing natively.
							var store := _EvalTask.new(_EvalTask.THUNK_STORE)
							store.thunk = thunk
							stack.append(store)
							var op_task := _EvalTask.new(_EvalTask.OPERATOR)
							op_task.op = expr
							op_task.env = thunk._env
							op_task.operands = strict_ops
							stack.append(op_task)
							continue
						res = expr.evaluate(thunk._env)
					else:
						res = expr.interpret(thunk._env)

					if res == null:
						res = Value.error("internal: expression produced no value")

					if res is Thunk and not (res as Thunk).evaluated:
						# Pass-through thunk: cache this one when the
						# inner one resolves, then evaluate the inner.
						var store := _EvalTask.new(_EvalTask.THUNK_STORE)
						store.thunk = thunk
						stack.append(store)
						var inner := _EvalTask.new(_EvalTask.THUNK)
						inner.thunk = res
						stack.append(inner)
						continue

					while res is Thunk and (res as Thunk).evaluated:
						res = (res as Thunk)._cache

					thunk._cache = res
					thunk.evaluated = true
					last_result = res
					if res != null and res.is_error():
						return _unwind(stack, res)

				_EvalTask.THUNK_STORE:
					task.thunk._cache = last_result
					task.thunk.evaluated = true

				_EvalTask.OPERATOR:
					if task.index >= task.operands.size():
						# All operands evaluated — run the operator.
						var computed: Value = task.op.compute(task.args)
						if computed == null:
							computed = Value.error(
									"internal: operator produced no value")
						if computed is Thunk and not (computed as Thunk).evaluated:
							var inner := _EvalTask.new(_EvalTask.THUNK)
							inner.thunk = computed
							stack.append(inner)
							continue
						while computed is Thunk and (computed as Thunk).evaluated:
							computed = (computed as Thunk)._cache
						last_result = computed
						if computed.is_error():
							return _unwind(stack, computed)
						continue

					var operand := task.operands[task.index]
					task.index += 1
					stack.append(task)  # come back for the next operand
					var arg_store := _EvalTask.new(_EvalTask.ARG_STORE)
					arg_store.parent = task
					stack.append(arg_store)

					if operand is Operator:
						var sub_ops: Array[Expr] = operand.get_strict_operands()
						if sub_ops.size() > 0:
							var sub := _EvalTask.new(_EvalTask.OPERATOR)
							sub.op = operand
							sub.env = task.env
							sub.operands = sub_ops
							stack.append(sub)
							continue

					var val: Value = operand.interpret(task.env)
					if val == null:
						val = Value.error("internal: expression produced no value")
					if val is Thunk and not (val as Thunk).evaluated:
						var inner := _EvalTask.new(_EvalTask.THUNK)
						inner.thunk = val
						stack.append(inner)
						continue
					while val is Thunk and (val as Thunk).evaluated:
						val = (val as Thunk)._cache
					last_result = val
					if val.is_error():
						return _unwind(stack, val)

				_EvalTask.ARG_STORE:
					if last_result != null and last_result.is_error():
						return _unwind(stack, last_result)
					task.parent.args.append(last_result)

		return last_result

	func unwrap() -> Variant:
		var forced := force()
		if forced == null:
			return null
		return forced.unwrap()


## Runtime-error value class
##
## Carries a structured failure (e.g. free identifier, division by
## zero) up the evaluation stack so the runner can surface a clean
## message instead of crashing on a null deref. Operators that
## force their operands check `is_error()` and return the same
## error instead of touching the wrapped data.
class ErrorValue extends Value:
	var message: String


	func _init(msg: String) -> void:
		type = Type.ERROR
		message = msg


	func _to_string() -> String:
		return "Value.Error(%s)" % message


	func is_error() -> bool:
		return true


	func error_message() -> String:
		return message


	func unwrap() -> Variant:
		return null

