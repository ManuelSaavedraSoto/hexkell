; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="hexkell"
config/version="0.1.1"
run/main_scene="uid://0ojgil6pkhy3"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://dw6dgcxtli2t7"

[autoload]

StaticData="*uid://cnk4d5jif44ak"
SceneManager="*uid://ced077uule6lm"
TemplateManager="*uid://btc8v6y8e4y84"
SaveManager="*uid://dc8oisv14r5ce"
ChapterManager="*res://src/singletons/chapter_manager.gd"
TutorialManager="*res://src/singletons/tutorial_manager.gd"
SfxManager="*res://src/singletons/sound/sfx_manager.gd"
BgmManager="*res://src/singletons/sound/bgm_manager.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/canvas_textures/default_texture_filter=1

[dotnet]

project/assembly_name="terminal-test"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

